# =============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT
# =============================================================================
# Backend API URL - Local development
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001

# MapTiler API Key - Get from https://cloud.maptiler.com/
# (Currently not used in the application, but reserved for future map functionality)
EXPO_PUBLIC_MAPTILER_API_KEY=replace-with-a-restricted-public-maptiler-key

# =============================================================================
# PRODUCTION ENVIRONMENT
# =============================================================================
# Set these in your deployment platform (Vercel, EAS, etc.)
EXPO_PUBLIC_BACKEND_URL=https://nearby-peb.onrender.com
EXPO_PUBLIC_MAPTILER_API_KEY=<from maptiler.com>

# =============================================================================
# VERCEL DEPLOYMENT
# =============================================================================
# For Vercel deployment, set these environment variables in Vercel dashboard:
# - EXPO_PUBLIC_BACKEND_URL: Your production API URL (https://nearby-peb.onrender.com)
# - EXPO_PUBLIC_MAPTILER_API_KEY: Your MapTiler API key (if needed)