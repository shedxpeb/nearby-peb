# =============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT
# =============================================================================
# Environment: development, staging, or production
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shedx
DIRECT_URL=

# Security Secrets - MUST be changed in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-replace-before-production
SESSION_SECRET=dev-only-session-replace-before-production

# Application URLs
APP_BASE_URL=http://localhost:8081
API_BASE_URL=http://localhost:8001

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://localhost:3001

# Storage Configuration
STORAGE_PROVIDER=local
STORAGE_ROOT=./storage
STORAGE_PUBLIC_URL=http://localhost:8001/uploads

# =============================================================================
# PRODUCTION ENVIRONMENT (for reference only - DO NOT use these values)
# =============================================================================
# ENVIRONMENT=production
# DATABASE_URL=postgresql://user:password@production-db-host:5432/shedx_prod
# JWT_SECRET=<generate: python -c "import secrets; print(secrets.token_urlsafe(48))">
# SESSION_SECRET=<generate: python -c "import secrets; print(secrets.token_urlsafe(48))">
# APP_BASE_URL=https://your-frontend-domain.com
# API_BASE_URL=https://your-api-domain.com
# ALLOWED_ORIGINS=https://your-frontend-domain.com,https://your-admin-domain.com
# STORAGE_PUBLIC_URL=https://your-api-domain.com/uploads